.venv/
datasets/
__pycache__/
*.pyc
.ipynb_checkpoints/
# Results are committed (~800KB of json + predictions) so any clone can
# re-audit the documented numbers; checkpoints are not (584MB, and every
# run is bit-for-bit reproducible anyway).
outputs/**/best.pt
checkpoints/
*.egg-info/
.claude/settings.local.json
.claude/*.tmp.*

mmsa_runs/

# MMSA reference checkout + its transformers 4.x environment (250MB of wheels
# and someone else's project). Rebuilt by scripts/setup_mmsa_reference.sh.
.mmsa-reference/

# float32 sidecars for the feature pickles: derived, large (MOSEI unaligned is
# ~8GB), and rebuilt on demand by msa.features.
datasets/**/.f32cache/
